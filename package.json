    "@react-three/drei": "^10.7.3",
    "@react-three/fiber": "^9.3.0",
    "@uiw/react-codemirror": "^4.25.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "three": "^0.179.1"
